          "editorMode": "code",
          "expr": "sum (increase(gen_ai_calls_total{span_name=~\"provider attempt.*\",status_code=\"STATUS_CODE_ERROR\",gen_ai_request_model=~\"$model\"}[$__range])) / clamp_min(sum (increase(gen_ai_calls_total{span_name=~\"provider attempt.*\",gen_ai_request_model=~\"$model\"}[$__range])), 0.0000001)",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "noValue": "0%",
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Failed upstream provider attempts. Errors appear on 'provider attempt' spans, not on the generation span."
